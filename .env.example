# ============================================================================
# Blog Award 2.0 - environment template
# ----------------------------------------------------------------------------
# 1. Copy this file to .env.local  (cp .env.example .env.local)
# 2. Replace the placeholder values on your own machine.
# 3. NEVER commit .env.local or any file containing real keys.
#
# Every value below is a PLACEHOLDER. Do not paste real credentials into
# this file, into chat, or into Git.
# ============================================================================

# --- Application -----------------------------------------------------------
# development | test | production. The app refuses to start in production
# if dangerous development payment settings are enabled.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project URL and public (anon) key: Supabase dashboard > Project Settings > API.
# These two are safe to expose to the browser because Row Level Security
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER ONLY. Bypasses Row Level Security. Used only in trusted server code
# (src/lib/supabase/admin.ts). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Payments --------------------------------------------------------------
# Master switch. Keep "false" until payments are explicitly approved and
# configured. While "false", no payment can start.
PAYMENTS_ENABLED=false

# disabled | mock | paystack
#   disabled : no payment provider (default)
#   mock     : simulated funding for local development and tests ONLY
#   paystack : real Paystack integration (use sk_test_/pk_test_ keys until
#              you are ready to go live)
PAYMENT_PROVIDER=disabled

# Must stay "false" in production. Only meaningful with PAYMENT_PROVIDER=mock.
ALLOW_SIMULATED_PAYMENTS=false

# Paystack: dashboard > Settings > API Keys & Webhooks.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Paystack signs each webhook (x-paystack-signature header) with
# HMAC-SHA512 of the raw request body, keyed with the secret key above.
# There is no separate webhook secret variable. The webhook handler is built
# in Level 4 and will be re-checked against the current Paystack docs.
